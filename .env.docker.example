# ═══════════════════════════════════════════════════════════════════════════
# SFX Relance — Variables d'environnement Docker
# Copier ce fichier en .env.docker et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données SQL Server (externe, sur la machine hôte) ───────────────
# host.docker.internal résout vers l'IP de la machine hôte depuis un container
DB_NAME=SFX_Relance
DB_USER=prisma_user
DB_PASSWORD=Prisma@2024!

# ── BrainOpx (même serveur SQL Server, base séparée) ────────────────────────
BRAINOPX_DATABASE=BopxFMT

# ── Chiffrement AES-256 ──────────────────────────────────────────────────────
# IMPORTANT : même clé pour server et web — ne jamais changer après le premier déploiement
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=af6778239474777d55e71923c1db084f2003ccdcc43f7c701392413f8833cdf6

# ── Next.js Auth ─────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=UAkTfvqKH7BB7N+gnFKgBcoCx1bd3s1wUQvMEVCPDkE=
# URL publique de l'application web (avec le port si non standard)
AUTH_URL=http:// 172.25.160.1:3001

# ── API de contrôle du worker ────────────────────────────────────────────────
# Token Bearer partagé entre web et server
WORKER_API_TOKEN=c2a08d46fdc8f416713629ef87db6873207375dc714002d44efa743b293be256

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM="SFX Relance <your@email.com>"
SMTP_SENDER_NAME="Service Cotations SFX Logistics"
SMTP_SENDER_PHONE="+237 6XX XXX XXX"
